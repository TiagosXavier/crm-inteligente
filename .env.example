# API Configuration (Backend Próprio - sem Base44)

# Local Development (não definir na Vercel — o frontend usa /api automaticamente em prod)
VITE_API_URL=http://localhost:3000/api

# AI Agent API (Railway)
VITE_AI_AGENT_API_URL=https://crmaiagent-production.up.railway.app

# ============================================================================
# VARIÁVEIS OBRIGATÓRIAS NA VERCEL (Environment Variables)
# ============================================================================

# JWT — secret para assinar tokens (OBRIGATÓRIO em produção)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=sua-chave-secreta-aqui
# JWT_EXPIRES_IN=7d

# Admin secret para proteger rotas /api/seed e /api/reset
# Em produção, se não definida, essas rotas ficam bloqueadas
# ADMIN_SECRET=sua-chave-secreta-aqui

# Google OAuth (obter em https://console.cloud.google.com/apis/credentials)
# VITE_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=
