{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo do contato"
    },
    "phone": {
      "type": "string",
      "description": "Telefone com DDD"
    },
    "email": {
      "type": "string",
      "description": "Email do contato"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do contato"
    },
    "company": {
      "type": "string",
      "description": "Empresa do contato"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para categoriza\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o contato"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o contato est\u00e1 ativo"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "em_atendimento",
        "aguardando",
        "resolvido",
        "escalado"
      ],
      "default": "novo",
      "description": "Status do contato no funil"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email do agente respons\u00e1vel"
    },
    "last_contact": {
      "type": "string",
      "format": "date-time",
      "description": "Data do \u00faltimo contato"
    }
  },
  "required": [
    "name",
    "phone"
  ]
}