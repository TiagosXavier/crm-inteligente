{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o"
    },
    "message": {
      "type": "string",
      "description": "Mensagem da notifica\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info",
      "description": "Tipo da notifica\u00e7\u00e3o"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Se a notifica\u00e7\u00e3o foi lida"
    },
    "link": {
      "type": "string",
      "description": "Link para redirecionar ao clicar"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que receber\u00e1 a notifica\u00e7\u00e3o"
    }
  },
  "required": [
    "title",
    "message",
    "user_email"
  ]
}